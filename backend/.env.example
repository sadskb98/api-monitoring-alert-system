# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development                 # development | test | production
PORT=4000
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent
LOG_FILE=                            # optional, e.g. logs/app.log (JSON lines, dir auto-created)
CORS_ORIGIN=http://localhost:5173    # comma-separated list

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# --- Ingestion & detection ---
MAX_BATCH_SIZE=1000                  # max records per POST /monitor (JSON body limit scales with this)
LATENCY_WARNING_MS=2000              # >= this -> medium
LATENCY_CRITICAL_MS=5000             # >= this -> high (must be > LATENCY_WARNING_MS)
ALERT_RESOLVE_AFTER_HEALTHY=1        # consecutive healthy observations before auto-resolve

# --- LLM (Gemini) ---
GEMINI_API_KEY=                      # optional; when empty, alerts use template messages
GEMINI_MODEL=                        # REQUIRED: Gemini model name (no default)
GEMINI_FALLBACK_MODELS=              # optional, comma-separated, e.g. gemini-3.5-flash; each tried once
                                     # when GEMINI_MODEL still fails after its retries with 503/UNAVAILABLE,
                                     # a timeout or 429 (quotas are per model); 400/other 4xx -> templates
LLM_TIMEOUT_MS=8000
LLM_MAX_RETRIES=2                    # retries on timeout, 429, 503 "high demand" and other 5xx
LLM_MAX_ITEMS=50                     # max alerts written per LLM call (rest use templates)
LLM_THINKING_LEVEL=minimal           # minimal | low | medium | high; lowest supported is model dependent
                                     # (if the model rejects it, the call is retried once without thinkingConfig)

# --- Email (optional) ---
EMAIL_ENABLED=false                  # one digest per batch: new/escalated alerts >= EMAIL_MIN_SEVERITY
EMAIL_MIN_SEVERITY=high              # low | medium | high | critical
EMAIL_FROM="API Monitor <alerts@api-monitor.local>"
EMAIL_TO=                            # required when EMAIL_ENABLED=true
SMTP_HOST=                           # empty -> Ethereal test inbox (dev; preview URL is logged); required in production
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
